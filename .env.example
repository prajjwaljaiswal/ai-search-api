# Private backend settings. Never commit .env or paste real keys in chat.
OPENAI_API_KEY=
CODEHENCE_EMBEDDING_MODEL=text-embedding-3-small
# Supabase Connect -> Transaction pooler URI. Empty means local SQLite.
DATABASE_URL=
# Optional Supabase root certificate PEM, with literal \n line separators.
SUPABASE_DB_CA=
# Production only: set your actual origin and a random admin secret.
# CODEHENCE_PUBLIC_ORIGIN=https://api.codehence.com
# CODEHENCE_ADMIN_KEY=
